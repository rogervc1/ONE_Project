# Configuracion de Claves de API (Elige tu proveedor preferido)
# 1. Google Gemini API (Gratuito 15 RPM en https://aistudio.google.com/)
GOOGLE_API_KEY=

# 2. Groq API (Gratuito 30 RPM / 14,400 RPD, Ultra Rapido Llama-3.3-70B en https://console.groq.com/keys)
GROQ_API_KEY=

# 3. OpenAI API (Opcional)
OPENAI_API_KEY=

# Configuracion de Vector DB
VECTOR_DB_DIR=./vector_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
