# Configuración de Claves de API (Elige tu proveedor preferido)
# 1. Google Gemini API (Gratuito 15 RPM en https://aistudio.google.com/)
GOOGLE_API_KEY=tu_google_api_key_aqui

# 2. Groq API (Gratuito 30 RPM / 14,400 RPD, Ultra Rápido Llama-3.3-70B en https://console.groq.com/keys)
GROQ_API_KEY=tu_groq_api_key_aqui

# 3. OpenAI API (Opcional)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Configuración de Vector DB
VECTOR_DB_DIR=./vector_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
